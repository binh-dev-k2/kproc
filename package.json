{
  "name": "kproc",
  "version": "2.1.0",
  "description": "Production-grade process and port management utility - Kill processes by PID, port, range, or pattern with verification, retry, and zero dependencies",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "node --test test/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/binh-dev-k2/kproc"
  },
  "keywords": [
    "kill",
    "process",
    "pid",
    "port",
    "kill-process",
    "kill-port",
    "kill-pid",
    "kill-pids",
    "fkill",
    "tree-kill",
    "process-tree",
    "zero-dependency",
    "kproc"
  ],
  "author": "binhcoder02@gmail.com",
  "license": "MIT",
  "type": "commonjs",
  "packageManager": "pnpm@12.0.0",
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}